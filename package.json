{
  "name": "xns-routes",
  "version": "1.0.0",
  "description": "On-chain route registry for XNS: human-readable action names that resolve to audited build contracts and transaction calldata.",
  "keywords": [
    "xns",
    "xns-routes",
    "routes",
    "ethereum",
    "smart-contracts",
    "name-service",
    "calldata",
    "wallets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walodja1987/xns-routes.git"
  },
  "homepage": "https://github.com/Walodja1987/xns-routes#readme",
  "bugs": {
    "url": "https://github.com/Walodja1987/xns-routes/issues"
  },
  "author": "Wladimir Weinbender (DIVA Technologies AG)",
  "license": "MIT",
  "scripts": {
    "help": "npx hardhat help",
    "accounts": "npx hardhat accounts",
    "balances": "npx hardhat balances",
    "node:hh": "npx hardhat node",
    "clean": "npx hardhat clean && forge clean",
    "snapshot": "forge snapshot --out forge-artifacts",
    "coverage:hh": "npx hardhat coverage",
    "coverage:forge": "forge coverage --report summary",
    "coverage:forge:report": "forge coverage --report lcov && lcov --remove lcov.info \"test/*\" \"script/*\" \"node_modules/*\" --output-file lcov.info --rc lcov_branch_coverage=1 && genhtml lcov.info --branch-coverage --output-dir coverage",
    "test:hh": "npx hardhat test",
    "test:forge": "forge test -vvv --root . -C contracts/src --match-path \"contracts/test/*\" --out forge-artifacts",
    "compile:hh": "npx hardhat clean && npx hardhat compile && yarn docs:generate",
    "compile:foundry": "forge build --root . -C contracts/src --optimize --out forge-artifacts",
    "size": "npx hardhat size-contracts",
    "xdeploy": "npx hardhat xdeploy",
    "abi": "npx hardhat export-abi",
    "vars:path": "npx hardhat vars path",
    "lines:XNSRoutes": "cloc contracts/src/XNSRoutes.sol",
    "lines": "cloc contracts/src/XNSRoutes.sol",
    "evm": "npx hardhat evm",
    "docs:fix-at": "node scripts/docs/fixApiAt.js",
    "docs:generate": "hardhat docgen && yarn docs:fix-at",
    "docs:clear": "rm -rf docs",
    "deploy:xns-routes:hh": "npx hardhat run --network hardhat scripts/deploy/deployXNSRoutes.ts",
    "deploy:xns-routes:sepolia": "npx hardhat run --network sepolia scripts/deploy/deployXNSRoutes.ts",
    "deploy:xns-routes:ethMain": "npx hardhat run --network ethMain scripts/deploy/deployXNSRoutes.ts",
    "prettier:check": "npx prettier -c \"**/*.{js,ts,md,sol,json,yml,yaml}\"",
    "prettier:fix": "npx prettier -w \"**/*.{js,ts,md,sol,json,yml,yaml}\"",
    "solhint:check": "npx solhint \"contracts/**/*.sol\"",
    "solhint:fix": "npx solhint \"contracts/**/*.sol\" --fix",
    "lint:check": "pnpm prettier:check && pnpm solhint:check && npx eslint .",
    "lint:fix": "pnpm prettier:fix && pnpm solhint:fix && npx eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@matterlabs/hardhat-zksync-deploy": "^1.5.0",
    "@matterlabs/hardhat-zksync-ethers": "1.2.1",
    "@matterlabs/hardhat-zksync-solc": "^1.2.5",
    "@matterlabs/hardhat-zksync-verify": "^1.6.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.6",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.6",
    "@nomicfoundation/hardhat-ledger": "^1.0.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@nomicfoundation/ignition-core": "^0.15.6",
    "@openzeppelin/contracts": "^5.5.0",
    "@tenderly/hardhat-tenderly": "^2.4.0",
    "@truffle/dashboard-hardhat-plugin": "^0.2.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.8",
    "chai": "^4.5.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.14",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.2.1",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^5.0.3",
    "solidity-coverage": "^0.8.13",
    "solidity-docgen": "0.6.0-beta.36",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "xdeployer": "^3.1.4",
    "zksync-ethers": "^6.14.0"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.1.0"
  }
}
